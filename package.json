{
  "name": "wxt-svelte-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "i18n:extract": "node scripts/extract-i18n.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node scripts/build-all.mjs",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "build:opera": "wxt build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "update": "npm-check-updates",
    "dprint": "dprint fmt",
    "lint": "prettier --check . && eslint .",
    "fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "generate:franc-map": "node scripts/generate-franc-map.ts"
  },
