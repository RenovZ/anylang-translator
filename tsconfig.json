{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noEmitOnError": false,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "paths": {
      "~icons/*": ["./.wxt/types/icons.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", ".wxt/wxt.d.ts", ".wxt/types/*.d.ts"]
}
